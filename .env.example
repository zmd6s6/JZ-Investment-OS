# Local development only. Copy to .env; never commit real credentials.
POSTGRES_DB=investment_os
POSTGRES_USER=investment_os
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
API_PORT=8100

INVESTMENT_OS_ENVIRONMENT=development
INVESTMENT_OS_DATABASE_URL=postgresql+asyncpg://investment_os:local-development-only@postgres:5432/investment_os
# Host-side integration tests use localhost rather than the Compose service name.
INVESTMENT_OS_TEST_DATABASE_URL=postgresql+asyncpg://investment_os:local-development-only@localhost:5432/investment_os
INVESTMENT_OS_WORKER_POLL_SECONDS=10
INVESTMENT_OS_WORKER_READY_FILE=/tmp/investment-os-worker-ready
# Optional and synthetic only. It must point to a strict explicit-calendar JSON file; no weekday
# inference or real market-data provider is enabled by default.
# INVESTMENT_OS_WORKER_SCHEDULE_CALENDAR_PATH=config/synthetic-calendar.json
