            "default": false,
            "title": "Live Trading",
            "type": "boolean"
          },
          "mode": {
            "const": "DEVELOPMENT",
            "default": "DEVELOPMENT",
            "title": "Mode",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "service": {
            "const": "investment-api",
            "default": "investment-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "alive",
            "default": "alive",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LivenessResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
