          },
          "source_schema_version": {
            "title": "Source Schema Version",
            "type": "string"
          },
          "source_tier": {
            "title": "Source Tier",
            "type": "string"
          },
          "supersedes_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Supersedes Id"
          }
        },
        "required": [
          "provider",
          "provider_ref",
          "artifact_type",
          "source_name",
          "source_locator",
          "source_tier",
          "observed_at",
          "effective_at",
          "available_at",
          "payload",
          "source_schema_version"
