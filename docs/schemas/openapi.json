            "items": {
              "type": "string"
            },
            "title": "Monitoring Conditions",
            "type": "array"
          },
          "parent_version_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Version Id"
          },
          "pillars": {
            "items": {
              "$ref": "#/components/schemas/ThesisPillarResponse"
            },
            "title": "Pillars",
            "type": "array"
          },
          "risks": {
            "items": {
              "$ref": "#/components/schemas/EvidenceClaimResponse"
            },
            "title": "Risks",
            "type": "array"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
