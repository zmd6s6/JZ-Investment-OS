          "instrument_id",
          "thesis_id",
          "version_id",
          "version",
          "parent_version_id",
          "state",
          "long_term_summary",
          "pillars",
          "catalysts",
          "risks",
          "invalidation_conditions",
          "monitoring_conditions",
          "change_reason",
          "evidence_ids",
