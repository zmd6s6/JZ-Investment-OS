          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "provider_ref": {
            "title": "Provider Ref",
            "type": "string"
          },
          "source_locator": {
            "title": "Source Locator",
            "type": "string"
          },
          "source_name": {
