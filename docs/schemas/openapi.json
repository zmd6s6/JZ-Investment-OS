          },
          "live_trading": {
            "const": false,
            "default": false,
            "title": "Live Trading",
            "type": "boolean"
          },
          "mode": {
            "const": "DEVELOPMENT",
            "default": "DEVELOPMENT",
            "title": "Mode",
            "type": "string"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "service": {
            "const": "investment-api",
            "default": "investment-api",
