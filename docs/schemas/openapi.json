            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ResearchIngestRequest": {
        "additionalProperties": false,
        "properties": {
          "artifact_type": {
            "title": "Artifact Type",
