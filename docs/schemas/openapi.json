  "info": {
    "description": "Evidence-backed research ingestion plus immutable Thesis and Decision Journal read APIs; no execution.",
    "title": "Personal AI Investment OS",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/decisions/{decision_id}": {
      "get": {
        "operationId": "read_decision_journal_api_v1_decisions__decision_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "decision_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Decision Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionJournalResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Decision Journal",
        "tags": [
          "decisions"
        ]
      }
    },
    "/api/v1/research/ingest": {
